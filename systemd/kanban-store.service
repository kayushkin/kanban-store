[Unit]
Description=Kanban store — boards/columns/placements + entity links and tags
After=network.target

[Service]
Type=simple
ExecStart=/home/kayushkincom/bin/kanban-store
Environment=KANBAN_PORT=8305
Environment=KANBAN_DB=/home/kayushkincom/.kanban-store/kanban-store.db
Environment=KANBAN_NOTEBOARD_URL=http://localhost:8191
Environment=HOME=/home/kayushkincom
WorkingDirectory=/home/kayushkincom/repos/kanban-store
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
